<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7fc;
            color: #333;
            line-height: 1.6;
        }

        header {
            background: #243b55;
            color: white;
            padding: 20px;
            text-align: center;
        }

        nav {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            background: #141e30;
            padding: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
        }

        nav a:hover {
            color: #00d4ff;
        }

        section {
            padding: 40px 20px;
            max-width: 1000px;
            margin: auto;
        }

        h2 {
            color: #243b55;
            margin-bottom: 15px;
        }

        #home {
            text-align: center;
            padding: 70px 20px;
            background: #dce8f7;
        }

        .skills, .projects, .education {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ccc;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        input, textarea, button {
            padding: 12px;
            font-size: 16px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        button {
            background: #243b55;
            color: white;
            cursor: pointer;
        }

        button:hover {
            background: #141e30;
        }

        footer {
            text-align: center;
            background: #141e30;
            color: white;
            padding: 15px;
        }

        /* Responsive Design */
        @media (max-width: 600px) {
            nav {
                flex-direction: column;
                align-items: center;
                gap: 10px;
            }

            .skills, .projects, .education {
                grid-template-columns: 1fr;
            }

            section {
                padding: 30px 15px;
            }
        }
    </style>
</head>

<body>

    <header>
        <h1>My Student Portfolio</h1>
        <p>Welcome to my personal website</p>
    </header>

    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#education">Education</a>
        <a href="#contact">Contact</a>
    </nav>

    <main>
        <section id="home">
            <h2>Home</h2>
            <h3>Hello, I am a Student!</h3>
            <p>Aspiring Software Developer and Technology Enthusiast.</p>
        </section>

        <section id="about">
            <h2>About Me</h2>
            <p>
                I am a student interested in programming, web development,
                and learning new technologies. I enjoy building projects
                and improving my technical skills.
            </p>
        </section>

        <section id="skills">
            <h2>My Skills</h2>
            <div class="skills">
                <article class="card">HTML</article>
                <article class="card">CSS</article>
                <article class="card">JavaScript</article>
                <article class="card">Java</article>
                <article class="card">Python</article>
                <article class="card">C Programming</article>
            </div>
        </section>

        <section id="projects">
            <h2>My Projects</h2>
            <div class="projects">
                <article class="card">
                    <h3>Student Management</h3>
                    <p>A system to manage student details.</p>
                </article>
                <article class="card">
                    <h3>Task Manager</h3>
                    <p>A website to organize daily tasks.</p>
                </article>
                <article class="card">
                    <h3>Portfolio Website</h3>
                    <p>A website to showcase my skills and work.</p>
                </article>
            </div>
        </section>

        <section id="education">
            <h2>Education</h2>
            <div class="education">
                <article class="card">
                    <h3>B.Tech</h3>
                    <p>Currently Pursuing</p>
                </article>
                <article class="card">
                    <h3>Intermediate</h3>
                    <p>Completed</p>
                </article>
                <article class="card">
                    <h3>School</h3>
                    <p>Completed</p>
                </article>
            </div>
        </section>

        <section id="contact">
            <h2>Contact Me</h2>
            <form class="contact-form"
                  onsubmit="event.preventDefault(); alert('Message submitted successfully!');">
                <input type="text" placeholder="Your Name" required>
                <input type="email" placeholder="Your Email" required>
                <textarea placeholder="Your Message" rows="4" required></textarea>
                <button type="submit">Send Message</button>
            </form>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 My Student Portfolio</p>
    </footer>

</body>
</html>